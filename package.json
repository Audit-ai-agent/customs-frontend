{
  "name": "@customs/frontend-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "dev": "npm run dev:local",
    "dev:local": "vite --host 127.0.0.1 --mode local-development",
    "dev:functional-uat": "vite --host 127.0.0.1 --mode functional-uat",
    "build": "vite build --mode local-development",
    "build:functional-uat": "vite build --mode functional-uat",
    "preview": "vite preview --host 127.0.0.1 --mode local-development",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-static-boundaries.mjs",
    "contract:generate": "node scripts/sync-backend-openapi.mjs",
    "contract:check": "node scripts/check-contract.mjs",
    "test": "vitest run",
    "check:quick": "npm run lint && npm run typecheck && npm run test",
    "check:contract": "npm run contract:check",
    "verify": "npm run check:quick && npm run check:contract && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "oidc-client-ts": "^3.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
