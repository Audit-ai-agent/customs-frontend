{
  "name": "@customs/frontend-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-static-boundaries.mjs",
    "contract:generate": "node scripts/sync-backend-openapi.mjs",
    "contract:check": "node scripts/check-contract.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "security:audit": "npm audit --audit-level=high",
    "verify": "npm run doctor && npm run lint && npm run contract:check && npm run typecheck && npm run test:coverage && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "axe-core": "^4.10.3",
    "jsdom": "^26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "oidc-client-ts": "^3.3.0"
  },
  "overrides": {
    "js-yaml": "4.3.0"
  }
}
